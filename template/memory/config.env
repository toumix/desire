# The one file that names you. Every value below is a placeholder.
# It lives at the root of MEMORY_REPO, not in the public prompts repo: what the agents work on is
# yours, the rules they follow are not.
USER=<your GitHub login>
AGENT=<the GitHub account your agents post as>
AGENT_EMAIL=<that account's email, the author of every agent commit>
WORK_REPOS=<owner/repo>,<owner/repo>
MEMORY_REPO=<owner>/memory
DESIRE_REPO=<owner>/desire
# The react that means "approved" when USER puts it on a comment. Anything GitHub accepts.
APPROVE_EMOJI=rocket
# Attribution markers used by your harnesses, comma-separated: each is a complete bare footer
# line or a token in its HTTPS link target. Keep markers needed to recognise existing posts.
AGENT_FOOTERS=<bare attribution line>,<attribution URL token>
# Pull requests written before the agent account existed, treated as AGENT-owned wherever
# authorship decides. Empty for a fresh setup: <owner/repo>:<number>,<number>
ADOPTED_PRS=
# Each WORK_REPO the agents mirror into a next repo they merge into themselves, keeping the drift
# from upstream small. Empty for a fresh setup, space-separated: <upstream owner/repo>:<next owner/repo>
NEXT_REPOS=
