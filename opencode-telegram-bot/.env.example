# Copy this to two files (or one, adjust systemd's EnvironmentFile= lines to match):
#   ~/.aider-bot.env     -> TELEGRAM_BOT_TOKEN, TELEGRAM_USER_ID
#   ~/.opencode-bot.env  -> everything else
# Never commit the real files.

# --- required ---
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_USER_ID=            # your numeric Telegram user id, from @userinfobot
                              # (the bot ignores messages from anyone else)

# --- optional, shown with their defaults ---
OPENCODE_BIN=/home/YOUR_USER/.opencode/bin/opencode
OPENCODE_MODEL=openrouter/anthropic/claude-sonnet-4.5
OPENCODE_TIMEOUT=600
#OPENCODE_REPO=/home/YOUR_USER/code/some-project   # default working dir; switch live with /repo

# --- only if opencode needs to hit the GitHub API (not just git push/pull over ssh) ---
#GH_TOKEN=
#GITHUB_TOKEN=
